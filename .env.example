# Server-only RPC URLs. Do not prefix with NEXT_PUBLIC_ or copy into kit exports.
EXITDRILL_PRIMARY_RPC_URL=
EXITDRILL_SECONDARY_RPC_URL=

# Optional: public address used only for read-only inspection experiments.
EXITDRILL_INSPECT_OWNER=

# Public origin of the web interface for hosted deploys. Every POST from any other origin is rejected.
EXITDRILL_ORIGIN=http://localhost:4310
